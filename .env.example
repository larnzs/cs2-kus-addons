# Copy this file to .env and edit the values before starting Docker Compose.
# Keep real credentials only in .env; that file is ignored by Git.
# A valid GSLT is required for a publicly listed server; leave blank only for testing/LAN.

API_KEY=
STEAM_ACCOUNT=
SERVER_PASSWORD=
RCON_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

PORT=27015
TICKRATE=128
MAXPLAYERS=32
LAN=0
EXEC=on_boot.cfg

IP=
MAP=de_dust2
GAME_TYPE=0
GAME_MODE=0
MAP_GROUP=mg_active

# Optional DuckDNS update; leave both empty if unused.
DUCK_DOMAIN=
DUCK_TOKEN=
