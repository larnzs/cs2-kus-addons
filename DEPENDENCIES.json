{
  "schema_version": 2,
  "name": "cs2-kus-addons",
  "architecture": {
    "base_repository": "kus/cs2-modded-server",
    "target_root": "game/csgo",
    "merge_mode": "non-destructive-overlay",
    "deletes_owned_files": false,
    "overwrite_existing_files": true,
    "platform_overlay_root": "game/csgo/addons/windows",
    "runtime_roots": {
      "windows": "server/game/csgo",
      "linux": "<SteamCMD install root>/game/csgo"
    }
  },
  "not_managed_by_this_repo": [
    "Source2ZE/MultiAddonManager",
    "Source2ZE/ServerListPlayersFix"
  ],
  "intentionally_kept_from_kus": [
    "connercsbn/SimpleAdmin"
  ],
  "addons": [
    {
      "order": 0,
      "name": "Metamod:Source",
      "repository": "https://github.com/alliedmodders/metamod-source",
      "readme_url": "https://www.metamodsource.net/downloads.php?branch=dev",
      "type": "github_release",
      "track": "latest",
      "version": "2.0.0-1476",
      "release_tag": "2.0.0.1476",
      "version_format": "metamod",
      "assets": [
        "mmsource-*-windows.zip",
        "mmsource-*-linux.tar.gz"
      ],
      "depends_on": [],
      "installed": true,
      "merge": "release_csgo_root",
      "verify_paths": [
        "addons/metamod/bin/win64/metamod.2.cs2.dll",
        "addons/metamod/bin/linuxsteamrt64/metamod.2.cs2.so",
        "addons/metamod.vdf",
        "addons/metamod_x64.vdf"
      ]
    },
    {
      "order": 1,
      "name": "CounterStrikeSharp",
      "repository": "https://github.com/roflmuffin/CounterStrikeSharp",
      "type": "github_release",
      "track": "latest",
      "version": "1.0.376",
      "release_tag": "v1.0.376",
      "assets": [
        "counterstrikesharp-with-runtime-windows-{version}.zip",
        "counterstrikesharp-with-runtime-linux-{version}.zip"
      ],
      "depends_on": [
        "Metamod:Source"
      ],
      "installed": true,
      "merge": "release_plugin_directory",
      "verify_paths": [
        "addons/windows/addons/counterstrikesharp/api/CounterStrikeSharp.API.dll",
        "addons/windows/addons/counterstrikesharp/bin/win64/counterstrikesharp.dll",
        "addons/windows/addons/counterstrikesharp/dotnet/dotnet.exe",
        "addons/counterstrikesharp/bin/linuxsteamrt64/counterstrikesharp.so"
      ],
      "runtime_required": true,
      "required_asset_name_contains": "with-runtime",
      "verify_globs": [
        "addons/windows/addons/counterstrikesharp/dotnet/shared/Microsoft.NETCore.App/*/System.Private.CoreLib.dll",
        "addons/windows/addons/counterstrikesharp/dotnet/host/fxr/*/hostfxr.dll"
      ],
      "source_path": "addons/counterstrikesharp",
      "install_path": "addons/windows/addons/counterstrikesharp",
      "asset_mappings": {
        "counterstrikesharp-with-runtime-windows-{version}.zip": [
          {
            "merge": "release_plugin_directory",
            "source_path": "addons/counterstrikesharp",
            "install_path": "addons/windows/addons/counterstrikesharp"
          },
          {
            "merge": "release_csgo_root"
          }
        ],
        "counterstrikesharp-with-runtime-linux-{version}.zip": [
          {
            "merge": "release_csgo_root"
          }
        ]
      }
    },
