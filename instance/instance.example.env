# FragCity Pterodactyl Instance payload seeding configuration.
# Copy to instance.env, edit for this Node, then keep it private (Git ignores it).
# This is a host-side private-payload root, not the shared CS2 Base Game path.
# It is not automatically a Pterodactyl volume; mount/integration is a separate PoC.
INSTANCE_STORAGE_ROOT="/var/lib/fragcity/instances"

# Optional: set these to the node-local account/group that must read a future mounted
# private payload. Leave both empty until the Pterodactyl mount/UID model is verified.
# If either is set, run create-instance.sh as root. Values are never customer-provided.
INSTANCE_OWNER=""
INSTANCE_GROUP=""
