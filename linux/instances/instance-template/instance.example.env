# Bash environment file for this CS2 instance. Copy to instance.env and protect it with chmod 600.
# If this directory remains under linux/instances/, REPO_ROOT can stay empty.
REPO_ROOT=""

# These match linux/install.sh.
SERVER_DIR="/home/steam/cs2"
STEAMRT_DIR="/home/steam/steamrt"
CS2_USER="steam"

# Advertised public address (optional); BIND_IP is the local listen address.
IP=""
BIND_IP="0.0.0.0"

PORT="27085"
TICKRATE="128"
MAXPLAYERS="64"
LAN="0"

API_KEY=""
STEAM_ACCOUNT=""
SERVER_PASSWORD=""
RCON_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

EXEC="aim.cfg"
MAPGROUP="mg_aim"
MAP="de_mirage"
WORKSHOP_COLLECTION=""

# Optional folder relative to this instance directory. Existing cfg/ and addons/ files are copied
# additively to SERVER_DIR/game/csgo immediately before each launch. Empty disables custom overlay.
CUSTOM_FOLDER=""
