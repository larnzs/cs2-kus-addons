[Unit]
Description=FragCity platform backup (MariaDB, Redis, website and configuration)
Wants=network-online.target
After=network-online.target mariadb.service redis-server.service
ConditionPathIsDirectory=/opt/fragcity/cs2-kus-addons/.git
ConditionPathIsDirectory=/var/www

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/fragcity/cs2-kus-addons
Environment=FRAGCITY_BACKUP_CONFIG=/etc/fragcity/backuper.conf
# Shared lock coordinates with the publisher's exclusive Git lock. Auto-update
# waits rather than changing the checkout while it is being archived.
ExecStart=/usr/bin/flock --shared /opt/fragcity/cs2-kus-addons/.git/fragcity-payload-stage.lock /usr/bin/bash /opt/fragcity/cs2-kus-addons/pterodactyl/backuper/fragcity-backuper.sh --run
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
UMask=0077
ProtectSystem=full
ReadWritePaths=/var/backups
PrivateTmp=true
NoNewPrivileges=true
