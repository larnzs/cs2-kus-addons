[Unit]
Description=FragCity platform backup (MariaDB, Redis, website and configuration)
Wants=network-online.target
After=network-online.target mariadb.service redis-server.service
ConditionPathIsDirectory=/opt/fragcity/cs2-kus-addons/.git
ConditionPathIsDirectory=/var/www

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/fragcity/cs2-kus-addons
Environment=FRAGCITY_BACKUP_CONFIG=/etc/fragcity/backuper.conf
# The script itself takes the shared Git lock only while archiving the checkout.
# This avoids nested flock locks while still keeping the updater out of the tar window.
ExecStart=/usr/bin/bash /opt/fragcity/cs2-kus-addons/pterodactyl/backuper/fragcity-backuper.sh --run
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
UMask=0077
ProtectSystem=full
ReadWritePaths=/var/backups
PrivateTmp=true
NoNewPrivileges=true
