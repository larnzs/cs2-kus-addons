[Unit]
Description=Stage the latest approved FragCity CS2 addon payload for Pterodactyl
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/opt/fragcity/cs2-kus-addons/.git

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/fragcity/cs2-kus-addons
Environment=FRAGCITY_GIT_BRANCH=integration/kus-monorepo
Environment=FRAGCITY_PAYLOAD_MOUNT=/var/lib/pterodactyl/mounts/fragcity-addon-payload
Environment=FRAGCITY_KEEP_REVISIONS=5
ExecStart=/opt/fragcity/cs2-kus-addons/pterodactyl/sync-addon-payload-host.sh
TimeoutStartSec=10min
UMask=0022
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
